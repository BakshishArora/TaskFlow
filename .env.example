# PostgreS DB
DATABASE_URL=postgresql+psycopg://root:1234@localhost:5432/taskdb

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secret
TASKFLOW_SECRET=change-me-to-a-long-random-secret

# Run Celery tasks synchronously in-process (1/true/yes) instead of
# dispatching to a worker. Set to true in tests / local dev without a worker.
CELERY_TASK_ALWAYS_EAGER=false